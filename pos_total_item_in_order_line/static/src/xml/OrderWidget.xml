<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_total_item_in_order_line.OrderWidgetCustome" t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">
        <xpath expr="//div[@class='d-flex flex-column flex-grow-1 rounded-3 bg-white overflow-hidden']" position="inside">
        <div t-if="props.taxTotals" class="order-summary d-flex flex-column gap-1 px-3 py-2 border-top fw-bolder lh-sm">
 
            <div class="d-flex justify-content-between w-100 fs-2">
                Total Item
                <div>
                    <span t-esc='props.taxTotals.storableLinesCount' class="total"></span> Item
                </div>
            </div>
            <div class="d-flex justify-content-between w-100 fs-2">
                Total Item Quantity
                <div>
                    <span t-esc='props.taxTotals.totalQuantity' class="total"/> Pcs
                </div>
            </div>
        </div>
        </xpath>
    </t>
</templates>    